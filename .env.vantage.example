# Vantage LIVE — ikinci proxy (port 8791)
# Kopyala: copy .env.vantage.example .env.vantage  ve doldur
# Baslat: start_crt_vantage.bat

ALLOW_REAL_TRADING=true
PORT=8791

# Vantage LIVE hesap (MT5 Navigator'daki tam server adi)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VantageInternational-Live

# Vantage MT5 terminal yolu (Program Files altindaki terminal64.exe)
# Ornek: C:\Program Files\Vantage International MT5\terminal64.exe
MT5_PATH=

CRT_DB_PATH=./data/trade_log_vantage.db
CRT_MANAGE_CFG_PATH=./data/manage_cfg_vantage.json
CRT_DEBUG_LOG_PATH=./data/debug_vantage.log

CRT_QUICK_TP_USD=2
CRT_PYTHON=D:/Projects/forex/runtime/python313/python.exe
